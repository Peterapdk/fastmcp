{
  "mcpServers": {
    "context7": {
      "command": "node",
      "args": [
        "node_modules/context7/dist/index.js"
      ],
      "env": {},
      "disabled": false,
      "alwaysAllow": []
    },
    "fastmcp": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "fastmcp",
        "fastmcp",
        "run",
        "https://github.com/jlowin/fastmcp"
      ],
      "env": {},
      "disabled": false,
      "alwaysAllow": []
    }
  }
}